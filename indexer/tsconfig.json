{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "esModuleInterop": true,
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "resolveJsonModule": true,
    "types": ["node"]
  },
  "include": ["./**/*.ts", "ponder-env.d.ts"],
  // scripts/ holds standalone manual scripts (e.g. trade-roundtrip.ts) that expect their own hoisted deps
  // and are not part of the Ponder app; typecheck the app only (keeps the workspace typecheck/CI green).
  "exclude": ["node_modules", "scripts"]
}
