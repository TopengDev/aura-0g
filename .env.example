# AURA - 0G Galileo testnet config (testnet ONLY). Copy to .env and fill in.
# .env is gitignored; NEVER commit a real key. All keys are SERVER-SIDE ONLY (never NEXT_PUBLIC).

# A funded Galileo testnet wallet (the smoke-test scripts + the demo-wallet funder). Get test 0G from https://faucet.0g.ai
PRIVATE_KEY=0xYOUR_TESTNET_PRIVATE_KEY
ADDRESS=0xYOUR_WALLET_ADDRESS

# The DEMO wallet that signs all API writes (generate + mint). Capped + software-rate-limited.
# For full isolation, set this to a DEDICATED faucet-funded wallet (~1.5 0G) whose 0G Compute
# ledger is funded (see src/03-compute.ts pattern). If unset, the API write routes are disabled.
DEMO_PRIVATE_KEY=0xYOUR_DEMO_WALLET_PRIVATE_KEY

# Optional cost guards for the demo wallet (defaults shown).
# AURA_MAX_GENERATIONS=40
# AURA_MAX_CONCURRENT_GEN=2
