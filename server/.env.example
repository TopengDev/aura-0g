# AURA v2 backend - env. The funded SPONSOR/attestor key is read from the REPO-ROOT .env (gitignored).
# This file documents the OPTIONAL server knobs (the entrypoint loads ../.env, so the key lives there).

# SPONSOR wallet = the funded .env key (PRIVATE_KEY in the repo-root .env). It pays 0G Compute +
# Storage for generation and IS the OutputNFT attestor (signs the EIP-712 MintAuth). It NEVER signs
# user mint/list/buy. Resolution order: SPONSOR_PRIVATE_KEY > PRIVATE_KEY > DEMO_PRIVATE_KEY.
# SPONSOR_PRIVATE_KEY=0x...

# HTTP
PORT=8787
HOST=0.0.0.0

# JWT (CHANGE in prod). TTL accepts ms-style strings (e.g. 1h, 30m).
JWT_SECRET=change-me-in-prod
JWT_TTL=1h

# SIWE binding. domain + uri must match the frontend origin the user signs from.
SIWE_DOMAIN=localhost:3000
SIWE_URI=http://localhost:3000

# CORS allowlist (comma-separated explicit origins; never "*", we use a Bearer token).
CORS_ORIGIN=http://localhost:3000

# Persistence (SQLite WAL) + generated-image cache. Default under server/data/.
# SQLITE_PATH=./data/aura.db
# GEN_DIR=./data/generated

# Cost guards (protect the funded sponsor wallet).
AURA_MAX_GENERATIONS=40
AURA_MAX_CONCURRENT_GEN=2
