{
  "name": "aura-server",
  "version": "0.1.0",
  "private": true,
  "description": "AURA v2 standalone backend (Fastify, Node 22, UNBUNDLED). User-wallet-signed creative-agent marketplace on 0G Galileo. Supplies computed args + EIP-712 attestations + chain reads; never signs user txs.",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start:dev": "tsx src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "verify": "tsx src/scripts/verify-e2e.ts",
    "verify:agent": "tsx src/scripts/verify-create-agent.ts",
    "verify:gacha": "tsx src/scripts/verify-gacha.ts",
    "verify:gacha:xcheck": "tsx src/scripts/verify-gacha-crosscheck.ts"
  },
  "dependencies": {
    "@0gfoundation/0g-compute-ts-sdk": "0.8.4",
    "@0gfoundation/0g-ts-sdk": "1.2.8",
    "@fastify/cors": "^10.0.1",
    "@fastify/jwt": "^9.0.1",
    "@fastify/multipart": "^9.0.1",
    "@fastify/rate-limit": "^10.1.1",
    "better-sqlite3": "^11.8.1",
    "canonicalize": "^2.0.0",
    "dotenv": "^17.4.2",
    "ethers": "6.13.1",
    "fastify": "^5.2.1",
    "viem": "^2.53.1"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.10.5",
    "tsx": "^4.22.4",
    "typescript": "^5.7.3"
  }
}
